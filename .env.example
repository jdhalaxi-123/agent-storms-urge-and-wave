# ===== 环境配置模板 =====
# 使用方法：复制本文件为 .env（同目录），填入自己的密钥/账号。
#   注意：.env 已被 .gitignore 排除，请勿提交或外发，密钥注意保密。
#   cp .env.example .env   （Windows: copy .env.example .env）

# ---------- 1. DeepSeek 对话大脑（必填） ----------
# 获取：https://platform.deepseek.com  ->  API Keys
# 注意：调用 DeepSeek 要**直连**，不要挂代理（启动脚本会自动清掉代理变量）
DEEPSEEK_API_KEY=sk-你的key

# ---------- 2. 课题数据库 FTP（必填，取数的唯一通道） ----------
# 预报数据都在课题组的 FTP 上，agent 提问时按需下载并缓存到 <项目根>/stormdata/
# 端口不是默认的 21，务必照抄；服务器是公网地址，能上网即可连通
FTP_HOST=120.42.36.229
FTP_PORT=22210
FTP_USER=你的FTP账号
FTP_PASS=你的FTP密码

# ---------- 3. 腾讯云 语音识别（可选） ----------
# 不填则用本地 faster-whisper 离线识别兜底，语音功能照样能用
# 获取：https://console.cloud.tencent.com/cam/capi
# TENCENT_SECRET_ID=你的SecretId
# TENCENT_SECRET_KEY=你的SecretKey
# TENCENT_ASR_REGION=ap-guangzhou

# ---------- 4. 数据仓目录（可选） ----------
# 默认 <项目根>/stormdata（下载的数据、生成的图、简报、日志都在这里）
# 想放到别的盘（比如数据多、C 盘小）就取消注释并改路径
# STORM_DATA_DIR=D:/stormdata
